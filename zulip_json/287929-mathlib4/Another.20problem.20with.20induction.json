</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">bracket'_tmul</span><span class=\"o\">,</span>\n<span class=\"w\">          </span><span class=\"n\">add_neg_cancel</span><span class=\"o\">]</span>\n<span class=\"w\">      </span><span class=\"bp\">·</span><span class=\"w\"> </span><span class=\"n\">intro</span><span class=\"w\"> </span><span class=\"n\">y₁</span><span class=\"w\"> </span><span class=\"n\">y₂</span><span class=\"w\"> </span><span class=\"n\">hy₁</span><span class=\"w\"> </span><span class=\"n\">hy₂</span>\n<span class=\"w\">        </span><span class=\"n\">simp</span><span class=\"w\"> </span><span class=\"n\">only</span><span class=\"w\"> </span><span class=\"o\">[</span><span class=\"n\">hy₁</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">hy₂</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">add_add_add_comm</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">add_zero</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">LinearMap</span><span class=\"bp\">.</span><span class=\"n\">add_apply</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">map_add</span><span class=\"o\">]</span>\n<span class=\"w\">    </span><span class=\"bp\">·</span><span class=\"w\"> </span><span class=\"n\">intro</span><span class=\"w\"> </span><span class=\"n\">y₁</span><span class=\"w\"> </span><span class=\"n\">y₂</span><span class=\"w\"> </span><span class=\"n\">hy₁</span><span class=\"w\"> </span><span class=\"n\">hy₂</span>\n<span class=\"w\">      </span><span class=\"n\">simp</span><span class=\"w\"> </span><span class=\"n\">only</span><span class=\"w\"> </span><span class=\"o\">[</span><span class=\"n\">add_add_add_comm</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">hy₁</span><span class=\"o\">,</span><span class=\"w\"> </span><span class=\"n\">hy₂</span><span class=\"o\">,</span><span c