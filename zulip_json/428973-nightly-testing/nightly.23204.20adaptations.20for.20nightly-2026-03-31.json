α)}</span>\n<span class=\"sd\">    [eqc] {DFunLike.coe of fun i j ↦ if i = j then 0 else if A i j = 0 then 1 else 0, A.compl}</span>\n<span class=\"sd\">  [ematch] E-matching patterns</span>\n<span class=\"sd\">    [thm] compl.eq_1: [@compl #6 #5 #4 #3 #2 #1 #0]</span>\n<span class=\"sd\">    [thm] of.eq_1: [@of #2 #1 #0]</span>\n<span class=\"sd\">[grind] Diagnostics</span>\n<span class=\"sd\">  [thm] E-Matching instances</span>\n<span class=\"sd\">    [thm] of.eq_1 ↦ 1</span>\n<span class=\"sd\">    [thm] compl.eq_1 ↦ 1</span>\n<span class=\"sd\">-/</span>\n<span class=\"bp\">#</span><span class=\"n\">guard_msgs</span><span class=\"w\"> </span><span class=\"k\">in</span>\n<span class=\"kn\">example</span><span class=\"w\"> </span><span class=\"o\">[</span><span class=\"n\">Zero</span><span class=\"w\"> </span><span class=\"n\">α</span><span class=\"o\">]</span><span class=\"w\"> </span><span class=\"o\">[</span><span class=\"n\">One</span><span class=\"w\"> </span><span class=\"n\">α</span><span class=\"o\">]</span><span class=\"w\"> </span><span class=\"o\">(</span><span class=\"n\">i</span><span class=\"w\"> </span><span class=\"n\">j</span><span class=\"w\"> </span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"n\">V</span><span class=\"o\">)</span><span class=\"w\"> </span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"n\">A</span><span class=\"bp\">.</span><span class=\"n\">compl</span><span class=\"w\"> </span><span class=\"n\">i</span><span class=\"w\"> </span><span class=\"n\">j</span><span class=\"w\"> </span><span class=\"bp\">=</span><span class=\"w\"> </span><span class=\"mi\">0</span><span class=\"w\"> </span><span class=\"bp\">∨</span><span class=\"w\"> </span><span class=\"n\">A</span><span class=\"bp\">.</span><span class=\"n\">compl</span><span class=\"w\"> </span><span class=\"n\">i</span><span class=\"w\"> </span><span class=\"n\">j</span><span class=\"w\"> </span><span class=\"bp\">=</span><span class=\"w\"