    {
        "content": "<div class=\"codehilite\" data-code-language=\"Lean4\"><pre><span></span><code><span class=\"n\">chasenorman</span><span class=\"bp\">@</span><span class=\"n\">Chases</span><span class=\"bp\">-</span><span class=\"n\">MacBook</span><span class=\"bp\">-</span><span class=\"n\">Air</span><span class=\"w\"> </span><span class=\"n\">AI</span><span class=\"w\"> </span><span class=\"bp\">%</span><span class=\"w\"> </span><span class=\"n\">lake</span><span class=\"w\"> </span><span class=\"n\">exe</span><span class=\"w\"> </span><span class=\"n\">ai</span>\n<span class=\"n\">chasenorman</span><span class=\"bp\">@</span><span class=\"n\">Chases</span><span class=\"bp\">-</span><span class=\"n\">MacBook</span><span class=\"bp\">-</span><span class=\"n\">Air</span><span class=\"w\"> </span><span class=\"n\">AI</span><span class=\"w\"> </span><span class=\"bp\">%</span>\n</code></pre></div>",
