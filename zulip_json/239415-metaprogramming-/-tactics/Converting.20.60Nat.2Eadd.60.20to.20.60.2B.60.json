    {
        "content": "<p><span aria-label=\"search\" class=\"emoji emoji-1f50d\" role=\"img\" title=\"search\">:search:</span> <a href=\"https://leanprover-community.github.io/mathlib4_docs/Init/Data/Nat/Basic.html#Nat.add_eq\">Nat.add_eq</a>, <a href=\"https://leanprover-community.github.io/mathlib4_docs/Mathlib/Tactic/NormNum/Basic.html#Mathlib.Meta.NormNum.isNat_add\">Mathlib.Meta.NormNum.isNat_add</a>, and <a href=\"https://loogle.lean-lang.org/?q=Nat.add%2C%20HAdd.hAdd\">5 more</a></p>",
        "id": 600952330,
