    },
    {
        "content": "<p>Could you elaborate this a bit more please, I'm in very new territory here <span aria-label=\"sweat smile\" class=\"emoji emoji-1f605\" role=\"img\" title=\"sweat smile\">:sweat_smile:</span></p>",
        "id": 632841890,
